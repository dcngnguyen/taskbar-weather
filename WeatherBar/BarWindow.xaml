<Window x:Class="WeatherBar.BarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Weather Bar" Width="80" Height="40"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        FontFamily="{StaticResource TextFont}">
  <!-- Hovering anywhere on the bar opens the forecast -->
  <Border x:Name="Bar" Background="{StaticResource Surface}" BorderBrush="{StaticResource Stroke}"
          BorderThickness="1" CornerRadius="6">
    <Border.ContextMenu>
      <ContextMenu Opened="Menu_Opened">
        <MenuItem Header="Quit Weather Bar" Click="Quit_Click" />
      </ContextMenu>
    </Border.ContextMenu>
    <StackPanel x:Name="BarContent" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
      <TextBlock x:Name="IconText" FontFamily="{StaticResource WeatherFont}" FontSize="16"
                 VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed" />
      <!-- Nudged up 1px to line up with the symbol -->
      <TextBlock x:Name="TempText" Text="--" FontSize="13" FontWeight="SemiBold"
                 Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center">
        <TextBlock.RenderTransform>
          <TranslateTransform Y="-1" />
        </TextBlock.RenderTransform>
      </TextBlock>
    </StackPanel>
  </Border>
</Window>

<Window x:Class="WeatherBar.ForecastPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Weather Bar forecast" Width="320" Height="470"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        FontFamily="{StaticResource TextFont}" Foreground="{StaticResource TextPrimary}">
  <Border x:Name="Root" Background="{StaticResource Surface}" BorderBrush="{StaticResource Stroke}"
          BorderThickness="1" CornerRadius="8">
    <Border.RenderTransform>
      <TranslateTransform x:Name="RootShift" />
    </Border.RenderTransform>
    <Grid Margin="0,12,0,10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Click the city name to pick another city -->
      <Button x:Name="CityButton" Style="{StaticResource SubtleButton}" Foreground="{StaticResource TextPrimary}"
              Padding="6,3" Margin="10,0,0,6" HorizontalAlignment="Left" Click="City_Click">
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="CityText" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                     MaxWidth="250" VerticalAlignment="Center" />
          <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="8,2,0,0"
                     Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>

      <!-- The forecast -->
      <Grid x:Name="ForecastView" Grid.Row="1" Margin="16,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Right now -->
        <Grid Margin="0,4,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="NowIcon" FontFamily="{StaticResource WeatherFont}" FontSize="34" VerticalAlignment="Center" />
            <TextBlock x:Name="NowTemp" FontSize="38" FontWeight="Light" Margin="10,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock x:Name="NowLabel" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" />
            <TextBlock x:Name="FeelsText" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" />
            <TextBlock x:Name="WindText" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" />
          </StackPanel>
        </Grid>

        <Border Grid.Row="1" Height="1" Background="{StaticResource Stroke}" Margin="0,12,0,10" />

        <!-- Next 12 hours, every 2 hours -->
        <ItemsControl x:Name="HourList" Grid.Row="2" Focusable="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Rows="1" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="{Binding Time}" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Look.Glyph}" Foreground="{Binding Look.Color}" FontFamily="{StaticResource WeatherFont}"
                           FontSize="18" Margin="0,4" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Temp}" FontSize="12" HorizontalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Row="3" Height="1" Background="{StaticResource Stroke}" Margin="0,10,0,4" />

        <!-- Next 7 days -->
        <ItemsControl x:Name="DayList" Grid.Row="4" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Height="30">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="56" />
                  <ColumnDefinition Width="30" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="40" />
                  <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Day}" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Look.Glyph}" Foreground="{Binding Look.Color}"
                           FontFamily="{StaticResource WeatherFont}" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding Rain}" FontSize="11" Foreground="{StaticResource RainBlue}"
                           VerticalAlignment="Center" Margin="8,0,0,0" />
                <TextBlock Grid.Column="3" Text="{Binding Min}" FontSize="12" Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="4" Text="{Binding Max}" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center" HorizontalAlignment="Right" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="6" Margin="0,4,0,0">
          <TextBlock x:Name="StatusText" FontSize="11" Foreground="{StaticResource TextSecondary}"
                     TextWrapping="Wrap" Margin="0,0,90,0" VerticalAlignment="Bottom" />
          <!-- Open-Meteo's free data asks for credit -->
          <TextBlock Text="Open-Meteo.com" FontSize="11" Foreground="{StaticResource TextSecondary}"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom" />
        </Grid>

        <TextBlock x:Name="MessageText" Grid.RowSpan="7" FontSize="12" Foreground="{StaticResource TextSecondary}"
                   TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="Collapsed" />
      </Grid>

      <!-- Choosing a city -->
      <StackPanel x:Name="SetupView" Grid.Row="1" Margin="16,0" Visibility="Collapsed">
        <TextBlock FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"
                   Text="Type your city and press Enter:" />
        <TextBox x:Name="CityBox" Style="{StaticResource DarkTextBox}" Margin="0,6,0,0" KeyDown="CityBox_KeyDown" />
        <TextBlock x:Name="SetupMessage" FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"
                   Margin="0,8,0,0" Visibility="Collapsed" />
        <ItemsControl x:Name="PlaceList" Margin="-10,6,-10,0" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Style="{StaticResource SubtleButton}" HorizontalContentAlignment="Left" Click="Place_Click">
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                             Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Detail}" FontSize="11" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button x:Name="CancelButton" Style="{StaticResource SubtleButton}" Content="Cancel" HorizontalAlignment="Left"
                Margin="-10,6,0,0" Click="Cancel_Click" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
